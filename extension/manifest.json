{
  "manifest_version": 3,
  "name": "Chrome Extension Backup Pro",
  "version": "2.0.0",
  "description": "Sistema profissional de backup e recuperação local dos ficheiros reais das extensões Google Chrome para Windows.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "management",
    "alarms",
    "notifications"
  ],
  "host_permissions": [],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Chrome Extension Backup Pro",
    "default_popup": "ui/index.html",
    "default_icon": {
      "16": "ui/icons/icon16.png",
      "32": "ui/icons/icon32.png",
      "48": "ui/icons/icon48.png",
      "128": "ui/icons/icon128.png"
    }
  },
  "icons": {
    "16": "ui/icons/icon16.png",
    "32": "ui/icons/icon32.png",
    "48": "ui/icons/icon48.png",
    "128": "ui/icons/icon128.png"
  },
  "minimum_chrome_version": "100"
}
